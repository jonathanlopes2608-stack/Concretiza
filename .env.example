# Exemplo de variáveis de ambiente — copie para .env e ajuste.
# Não versionar o arquivo .env com valores reais.

# -----------------------------------------------------------------------------
# Desenvolvimento local
# -----------------------------------------------------------------------------
NODE_ENV=development
PORT=3047
APP_URL=http://localhost:3047
AUTH_SECRET=altere-para-um-segredo-longo-e-aleatorio
AUTH_TRUST_HOST=true

# Banco — host 5437 dedicado (evita conflito com outros Postgres na :5432)
DATABASE_URL=postgresql://concretiza:concretiza@localhost:5437/concretiza?schema=public

# Admin seed (usado por prisma/seed.ts / npm run db:seed)
ADMIN_EMAIL=admin@concretiza.local
ADMIN_PASSWORD=Admin@123

# Uploads
UPLOAD_DIR=uploads

# Google Calendar (OAuth — conta pessoal do usuário) — opcional no MVP web
# Deixe vazio para desligar a integração. Em produção HTTPS use o redirect público.
#   https://SEU_APP/api/agenda/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3047/api/agenda/google/callback
# Chave para criptografar refresh tokens (pode reutilizar AUTH_SECRET)
TOKEN_ENCRYPTION_KEY=
# Fuso dos eventos espelhados
TZ_AGENDA=America/Sao_Paulo

# -----------------------------------------------------------------------------
# White-label / correspondente (opcional — um deploy por correspondente)
# Sem multi-tenant no mesmo banco: troque marca por instalação.
# Alternativa: editar defaults em src/config/branding.ts e redeployar.
# -----------------------------------------------------------------------------
# BRAND_NAME=Concretiza
# BRAND_SHORT_NAME=Concretiza
# BRAND_SLOGAN=Financiamentos
# BRAND_LOGO=/branding/concretiza-logo.png
# BRAND_RAZAO_SOCIAL=Concretiza Financiamentos
# BRAND_CNPJ=
# BRAND_TELEFONE=
# BRAND_SITE=
# BRAND_COLOR_900=#1E3A5F
# BRAND_COLOR_700=#2E6FB0
# BRAND_COLOR_500=#29ABE2

# -----------------------------------------------------------------------------
# Produção (Railway ou VPS com docker-compose.prod.yml)
# -----------------------------------------------------------------------------
# Gere AUTH_SECRET forte, por exemplo:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Railway:
#   DATABASE_URL  → fornecido pelo plugin PostgreSQL (referência de variável)
#   APP_URL       → https://seu-servico.up.railway.app  (COM https://; sem barra no final)
#   AUTH_URL      → mesmo valor de APP_URL (obrigatório no Docker/Railway)
#   AUTH_SECRET   → obrigatório
#   AUTH_TRUST_HOST=true
#   ADMIN_EMAIL / ADMIN_PASSWORD → senha forte; NÃO use Admin@123
#   UPLOAD_DIR=/app/uploads
#   GOOGLE_*      → vazios até ligar a agenda
#   BRAND_*       → opcional (white-label); ver seção em docs/DEPLOY.md
#
# Sem AUTH_URL/APP_URL com https://, o Auth.js gera callbacks em https://0.0.0.0:PORT
# e o botão Entrar parece não funcionar.
#
# VPS (docker-compose.prod.yml) — além das acima:
# POSTGRES_USER=concretiza
# POSTGRES_PASSWORD=troque-esta-senha
# POSTGRES_DB=concretiza
# APP_PORT=3047
# APP_URL=https://seu-dominio-ou-ip
# AUTH_SECRET=
# ADMIN_EMAIL=seu@email.com
# ADMIN_PASSWORD=
